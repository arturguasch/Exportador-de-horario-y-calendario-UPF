  "help1": {
    "message": "Open the <a href=\"https://secretariavirtual.upf.edu\" target=\"_blank\" rel=\"noopener noreferrer\"><strong>UPF virtual secretary</strong></a> <strong>(recommended for better accuracy)</strong> or <a href=\"https://gestioacademica.upf.edu/pds/consultaPublica/look[conpub]InicioPubHora?entradaPublica=true&idiomaPais=ca.ES\" target=\"_blank\" rel=\"noopener noreferrer\"><strong>gestioacadèmica</strong></a>."
  },
  "help2": {
    "message": "Open the <strong>class calendar</strong>."
  },
  "help3": {
    "message": "Choose the <strong>start date</strong> and <strong>end date</strong>."
  },
  "help4": {
    "message": "Click <strong>Detect subjects</strong>."
  },
  "help5": {
    "message": "Select the subjects you want to export."
  },
  "help6": {
    "message": "Enable <strong>Create one .ics per selected subject</strong> if you want to import each subject into a different calendar."
  },
  "help7": {
    "message": "Click <strong>Export .ics</strong>."
  },
  "help8": {
    "message": "The <strong>.ics</strong> file is a calendar file; it should theoretically work in any calendar app, although it has only been thoroughly tested in <strong>Google Calendar</strong>."
  },
  "help9": {
    "message": "To import it into <strong>Google Calendar</strong>, go to <strong>Settings → Import & export → Import</strong>, select the <strong>.ics</strong> file and choose the calendar where you want to add the events."
  },
  "helpImportant": {
    "message": "<strong>IMPORTANT:</strong> To get colors in Google Calendar, create one calendar per subject and assign a different color to each calendar. Then import each subject's .ics into its corresponding calendar."
  },
